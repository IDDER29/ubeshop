
    <!-- Premier écran : mise en page d’origine, textes du cahier -->
    <section class="hero hero--textured hero--photo">
      <div class="wrap hero__copy">
        <p class="script">Entre vanille et noisette…</p>
        <h1 class="h-display hero__title">Votre prochain latte, à&nbsp;l’ube.</h1>
        <p class="hero__lead">Découvrez Éclat d’Ube, notre poudre d’ube pour les lattes et les desserts maison.</p>
        <div class="hero__actions">
          <a class="btn btn--lg" href="{% if settings.featured_product != blank %}{{ settings.featured_product.url }}{% elsif all_products['eclat-dube'] != blank %}{{ all_products['eclat-dube'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">Découvrir Éclat d’Ube</a>
          <a class="link-arrow" href="#preparation">Voir la préparation</a>
        </div>
        <p class="hero__meta">50 g · Jusqu’à 25 lattes à 2 g · <strong>dès <span data-from-price>17,90 €</span></strong></p>
      </div>
      <picture class="hero__scene">
        <source media="(min-width: 1024px) and (min-aspect-ratio: 4/3)" srcset="{{ 'hero-bg.webp' | asset_url }}" width="1996" height="768">
        <img src="{{ 'hero-scene.webp' | asset_url }}" width="1672" height="941" alt="Une canette Éclat d’Ube, un bol de poudre violette et un latte glacé à l’ube sur un plateau en bois" fetchpriority="high">
      </picture>
    </section>

    <!-- Formats -->
    <section class="section" id="formats">
      <div class="wrap">
        <h2 class="h-section">Choisissez votre format.</h2>
        <p class="script section-sub">Pour vous, ou à partager.</p>
        <p class="section-lead">La même poudre d’ube, en une, trois ou six canettes.</p>
        <div class="formats">
          <article class="format-card">
            <a class="format-card__media zoomable" href="{% if settings.featured_product != blank %}{{ settings.featured_product.url }}{% elsif all_products['eclat-dube'] != blank %}{{ all_products['eclat-dube'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}?format=canette-1" aria-label="Voir Éclat d’Ube, une canette">
              <img src="{{ 'format-1.webp' | asset_url }}" width="900" height="675" alt="Une canette Éclat d’Ube" loading="lazy" decoding="async">
            </a>
            <div class="format-card__body">
              <h3>Éclat d’Ube</h3>
              <div class="format-card__size">50 g</div>
              <div class="format-card__price">17,90 €</div>
              <div class="format-card__unit">17,90 € / canette</div>
              <div class="format-card__detail">Jusqu’à 25 lattes à 2 g</div>
              <div class="format-card__tag">Pour découvrir</div>
              <button class="btn btn--sm" type="button" data-add="canette-1">Ajouter au panier</button>
            </div>
          </article>
          <article class="format-card">
            <a class="format-card__media zoomable" href="{% if settings.featured_product != blank %}{{ settings.featured_product.url }}{% elsif all_products['eclat-dube'] != blank %}{{ all_products['eclat-dube'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}?format=coffret-3" aria-label="Voir le coffret découverte, trois canettes">
              <img src="{{ 'format-3.webp' | asset_url }}" width="900" height="675" alt="Trois canettes Éclat d’Ube" loading="lazy" decoding="async"><span class="format-card__save">−13 %</span>
            </a>
            <div class="format-card__body">
              <h3>Coffret découverte</h3>
              <div class="format-card__size">3 × 50 g · 150 g</div>
              <div class="format-card__price">46,90 €</div>
              <div class="format-card__unit">15,63 € / canette</div>
              <div class="format-card__detail">6,80 € économisés · Livraison offerte</div>
              <div class="format-card__tag">À partager</div>
              <button class="btn btn--sm" type="button" data-add="coffret-3">Ajouter au panier</button>
            </div>
          </article>
          <article class="format-card">
            <a class="format-card__media zoomable" href="{% if settings.featured_product != blank %}{{ settings.featured_product.url }}{% elsif all_products['eclat-dube'] != blank %}{{ all_products['eclat-dube'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}?format=coffret-6" aria-label="Voir le coffret à partager, six canettes">
              <img src="{{ 'format-6.webp' | asset_url }}" width="900" height="675" alt="Six canettes Éclat d’Ube" loading="lazy" decoding="async"><span class="format-card__save">−21 %</span>
            </a>
            <div class="format-card__body">
              <h3>Coffret à partager</h3>
              <div class="format-card__size">6 × 50 g · 300 g</div>
              <div class="format-card__price">84,90 €</div>
              <div class="format-card__unit">14,15 € / canette</div>
              <div class="format-card__detail">22,50 € économisés · Livraison offerte</div>
              <div class="format-card__tag">Pour en profiter plus longtemps</div>
              <button class="btn btn--sm" type="button" data-add="coffret-6">Ajouter au panier</button>
            </div>
          </article>
        </div>
        <p class="formats__note">La poudre revient à <span data-latte-price="canette-1">0,72 €</span> par latte à 2 g avec une canette, <span data-latte-price="coffret-3">0,63 €</span> avec le coffret découverte et <span data-latte-price="coffret-6">0,57 €</span> avec le coffret à partager, hors lait et garnitures.</p>
      </div>
    </section>

    <!-- Avis clients: remove "hidden" once real reviews replace the placeholders -->
    <section class="section" id="avis">
      <div class="wrap">
        <h2 class="h-section">Vous l’avez goûté.</h2>
        <p class="script section-sub">Vos mots, pas les nôtres…</p>
        <div class="reviews-block" hidden>
          <div class="reviews" data-carousel aria-label="Avis clients">
            <figure class="review">
              <blockquote><span class="placeholder">[Avis client réel, avec son accord]</span></blockquote>
              <figcaption><span class="placeholder">[Prénom, initiale]</span> · <span class="placeholder">[date]</span></figcaption>
            </figure>
            <figure class="review">
              <blockquote><span class="placeholder">[Avis client réel, avec son accord]</span></blockquote>
              <figcaption><span class="placeholder">[Prénom, initiale]</span> · <span class="placeholder">[date]</span></figcaption>
            </figure>
            <figure class="review">
              <blockquote><span class="placeholder">[Avis client réel, avec son accord]</span></blockquote>
              <figcaption><span class="placeholder">[Prénom, initiale]</span> · <span class="placeholder">[date]</span></figcaption>
            </figure>
          </div>
          <p class="reviews__note"><span class="placeholder">[Avis recueillis auprès de nos clients après leur commande : à confirmer]</span></p>
        </div>
        <div class="review-invite">
          <p class="review-invite__title">Vous avez commandé ? Laissez-nous votre avis.</p>
          <p class="review-invite__text">Votre premier latte, un gâteau, une idée : racontez-nous. Vos mots apparaîtront peut-être ici.</p>
          <a class="btn btn--ghost" href="{{ pages["contact"].url | default: "/pages/contact" }}?sujet=avis#c-subject">Laisser un avis</a>
        </div>
      </div>
    </section>

    <!-- Trois gestes -->
    <section class="section section--cream" id="preparation">
      <div class="wrap">
        <h2 class="h-section">Trois gestes, un latte violet.</h2>
        <p class="script section-sub">Simple comme un latte…</p>
        <div class="steps">
          <figure class="step">
            <img src="{{ 'step-dose.webp' | asset_url }}" width="900" height="675" alt="Une cuillère verse de la poudre d’ube dans un bol" loading="lazy" decoding="async">
            <figcaption><span class="step__num">01</span> Dosez 2 à 3 g de poudre.</figcaption>
          </figure>
          <figure class="step">
            <img src="{{ 'step-mix.webp' | asset_url }}" width="900" height="675" alt="La poudre mélangée au mousseur dans un bol" loading="lazy" decoding="async">
            <figcaption><span class="step__num">02</span> Mélangez selon les indications de préparation.</figcaption>
          </figure>
          <figure class="step">
            <img src="{{ 'step-milk.webp' | asset_url }}" width="900" height="675" alt="Du lait versé dans un verre de glace et d’ube" loading="lazy" decoding="async">
            <figcaption><span class="step__num">03</span> Ajoutez le lait de votre choix, chaud ou glacé.</figcaption>
          </figure>
        </div>
        <p class="center section-cta"><a class="btn btn--ghost" href="{{ pages["recettes"].url | default: "/pages/recettes" }}#latte-signature">Voir la recette complète</a></p>
      </div>
    </section>

    <!-- Recettes -->
    <section class="section" id="recettes">
      <div class="wrap">
        <h2 class="h-section">Trois façons de commencer.</h2>
        <p class="script section-sub">Un peu de violet dans la cuisine…</p>
        <div class="recipes" data-carousel aria-label="Recettes">
          <article class="recipe">
            <a class="recipe__img zoomable" href="{{ pages["recettes"].url | default: "/pages/recettes" }}#latte-signature" tabindex="-1" aria-hidden="true"><img src="{{ 'recipe-latte.webp' | asset_url }}" width="1000" height="750" alt="" loading="lazy" decoding="async"></a>
            <h3><a href="{{ pages["recettes"].url | default: "/pages/recettes" }}#latte-signature">Latte glacé, mousse vanille</a></h3>
            <p class="recipe__desc">Notre recette signature.</p>
          </article>
          <article class="recipe">
            <a class="recipe__img zoomable" href="{{ pages["recettes"].url | default: "/pages/recettes" }}#cake-ube" tabindex="-1" aria-hidden="true"><img src="{{ 'recipe-cake.webp' | asset_url }}" width="1000" height="750" alt="" loading="lazy" decoding="async"></a>
            <h3><a href="{{ pages["recettes"].url | default: "/pages/recettes" }}#cake-ube">Cake à l’ube</a></h3>
            <p class="recipe__desc">À couper en tranches et à partager.</p>
          </article>
          <article class="recipe">
            <a class="recipe__img zoomable" href="{{ pages["recettes"].url | default: "/pages/recettes" }}#cookies-ube" tabindex="-1" aria-hidden="true"><img src="{{ 'recipe-cookies.webp' | asset_url }}" width="1000" height="750" alt="" loading="lazy" decoding="async"></a>
            <h3><a href="{{ pages["recettes"].url | default: "/pages/recettes" }}#cookies-ube">Cookies à l’ube</a></h3>
            <p class="recipe__desc">Pour votre prochaine fournée.</p>
          </article>
        </div>
        <p class="center section-cta"><a class="btn btn--ghost" href="{{ pages["recettes"].url | default: "/pages/recettes" }}">Toutes les recettes</a></p>
      </div>
    </section>

    <!-- Histoire et origine -->
    <section class="section section--cream story-band" id="histoire">
      <div class="wrap story-band__inner">
        <div class="story-band__copy">
          <p class="script">Il était une fois une racine violette…</p>
          <h2 class="h-section">Des Philippines à votre cuisine.</h2>
          <p>Une couleur qui intrigue, une première recette à essayer. Avec Éclat d’Ube, l’histoire se poursuit dans votre cuisine : dans un latte, un cake ou une fournée de cookies.</p>
          <a class="btn btn--ghost" href="{{ pages["notre-histoire"].url | default: "/pages/notre-histoire" }}">Découvrir notre histoire</a>
        </div>
        <div class="story-band__photos">
          <figure class="story-band__img story-band__img--field">
            <img src="{{ 'story-roots.webp' | asset_url }}" width="1536" height="1024" alt="Racines d’ube coupées révélant leur chair violette, dans un panier tressé au bord d’un champ" loading="lazy" decoding="async">
            <figcaption class="img-credit">Illustration de la culture de l’ube</figcaption>
          </figure>
          <figure class="story-band__img story-band__img--hands">
            <img src="{{ 'story-hands.webp' | asset_url }}" width="800" height="1000" alt="Des mains épluchent une racine d’ube dans une cuisine, à côté d’un bol de morceaux violets" loading="lazy" decoding="async">
          </figure>
        </div>
      </div>
    </section>

    <!-- Offrir -->
    <section class="section">
      <div class="wrap">
        <div class="gift-card">
          <img src="{{ 'gift-trio.webp' | asset_url }}" width="1000" height="800" alt="Le coffret découverte : trois canettes Éclat d’Ube" loading="lazy" decoding="async">
          <div class="gift-card__copy">
            <h2>Faites découvrir l’ube à vos proches.</h2>
            <p>Un anniversaire, une invitation ou le plaisir de partager une découverte.</p>
            <ul class="gift-card__facts">
              <li>Coffret découverte · 3 × 50 g</li>
              <li>−13 % · 6,80 € économisés</li>
              <li>Livraison offerte</li>
            </ul>
            <a class="btn" href="{% if settings.featured_product != blank %}{{ settings.featured_product.url }}{% elsif all_products['eclat-dube'] != blank %}{{ all_products['eclat-dube'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}?format=coffret-3">Offrir le coffret · <span data-format-price="coffret-3">46,90 €</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="faq">
      <div class="wrap">
        <h2 class="h-section">Une question avant de commencer ?</h2>
        <p class="section-lead">Tout ce qu’il faut savoir avant votre premier latte à l’ube.</p>
        <div class="faq">
          <details>
            <summary>Qu’est-ce que l’ube ?</summary>
            <p>L’ube est une igname violette (<em>Dioscorea alata</em>), très présente dans les desserts philippins. Éclat d’Ube en est la poudre : les racines sont cuites, séchées puis finement moulues. <a href="{{ pages["decouvrir-ube"].url | default: "/pages/decouvrir-ube" }}">En savoir plus sur l’ube</a></p>
          </details>
          <details>
            <summary>Quel goût a Éclat d’Ube ?</summary>
            <p>Un goût doux, entre vanille et noisette, avec une couleur violette naturelle.</p>
          </details>
          <details>
            <summary>Combien de lattes avec une canette ?</summary>
            <p>Jusqu’à 25 lattes avec 2 g par préparation, environ 16 à 3 g. La quantité varie selon le dosage et la recette.</p>
          </details>
          <details>
            <summary>Quand la livraison est-elle offerte ?</summary>
            <p>La livraison est offerte en France métropolitaine dès 45 € d’achat : le coffret découverte en profite déjà. En dessous, elle est facturée 5,90 €.</p>
          </details>
        </div>
      </div>
    </section>

{% schema %}
