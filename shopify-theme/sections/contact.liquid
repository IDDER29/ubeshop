
    <section class="ube-hero wall">
      <div class="wrap ube-hero__inner">
        <div class="ube-hero__copy">
          <p class="script">Une question, une idée ?</p>
          <h1 class="h-display">Écrivez-nous</h1>
          <p>Une commande, un conseil de préparation, une recette à partager : nous lisons chaque message.</p>
        </div>
        <figure class="ube-hero__img">
          <img src="{{ 'contact-hero.webp' | asset_url }}" width="1400" height="788" alt="Canette Éclat d’Ube, latte glacé à l’ube et bol de poudre sur un plateau en bois" fetchpriority="high">
        </figure>
      </div>
    </section>

    <section class="section">
      <div class="wrap contact">
        {% form 'contact', id: 'contact-message', class: 'panel contact-form' %}
          <h2 class="panel__title">Votre message</h2>
          <div class="form-grid">
            <div class="field">
              <label for="c-name">Nom</label>
              <input class="input" id="c-name" name="contact[name]" autocomplete="name" required>
              <p class="field__error">Indiquez votre nom.</p>
            </div>
            <div class="field">
              <label for="c-email">Adresse e-mail</label>
              <input class="input" id="c-email" name="contact[email]" type="email" autocomplete="email" required>
              <p class="field__error">Indiquez une adresse e-mail valide.</p>
            </div>
            <div class="field span-2">
              <label for="c-subject">Sujet</label>
              <select class="input" id="c-subject" name="contact[Sujet]">
                <option>Question sur Éclat d’Ube</option>
                <option>Suivi de commande</option>
                <option>Livraison et retours</option>
                <option value="Laisser un avis" data-sujet="avis">Laisser un avis</option>
                <option>Autre</option>
              </select>
            </div>
            <div class="field span-2">
              <label for="c-message">Message</label>
              <textarea class="input" id="c-message" name="contact[body]" rows="6" required minlength="10"></textarea>
              <p class="field__error">Votre message doit contenir au moins 10 caractères.</p>
            </div>
          </div>
          <button class="btn" type="submit">Envoyer le message</button>
          {% if form.posted_successfully? %}<p class="form-status" role="status">Merci, votre message a bien été envoyé.</p>{% elsif form.errors %}<div class="form-status" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        {% endform %}

        <aside class="contact-aside">
          <div class="value-card">
            <h3>Par e-mail</h3>
            <p><a href="mailto:contact@ubehalaya.fr">contact@ubehalaya.fr</a><br>Réponse sous 24 h.</p>
          </div>
          <div class="value-card">
            <h3>Livraison et retours</h3>
            <p>Délais, frais et retours : <a href="{{ pages["livraison"].url | default: "/pages/livraison" }}">toutes les réponses</a>.</p>
          </div>
          <div class="value-card">
            <h3>Recettes</h3>
            <p>Besoin d’inspiration ? <a href="{{ pages["recettes"].url | default: "/pages/recettes" }}">Nos recettes à l’ube</a>.</p>
          </div>
        </aside>
      </div>
    </section>

{% schema %}
{
  "name": "Contact",
  "settings": []
}
{% endschema %}
