
  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-main">
        <div class="footer-brand">
          <a class="logo logo--sm" href="{{ routes.root_url }}" aria-label="Ube Halaya — accueil">
            <img src="{{ 'logo.webp' | asset_url }}" width="72" height="72" alt="" loading="lazy">
          </a>
          <p class="footer-brand__script">Un peu de violet dans la cuisine…</p>
          <p class="footer-brand__text">La poudre d’ube pour vos lattes et vos desserts maison.</p>
          <ul class="footer-social" aria-label="Réseaux sociaux">
            <li><a href="https://www.instagram.com/ubehalaya/" target="_blank" rel="noopener" aria-label="Instagram @ubehalaya (nouvel onglet)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".6" fill="currentColor"/></svg>@ubehalaya</a></li>
            <li><a href="https://www.tiktok.com/@ubehalaya.fr" target="_blank" rel="noopener" aria-label="TikTok @ubehalaya.fr (nouvel onglet)"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 2h-3.3v13.2a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9a6.3 6.3 0 1 0 5.3 6.2V8.6a7.7 7.7 0 0 0 4.4 1.4V6.7a4.4 4.4 0 0 1-4.4-4.4z"/></svg>@ubehalaya.fr</a></li>
          </ul>
        </div>
        <nav class="footer-cols" aria-label="Pied de page">
          <div class="footer-col">
            <h2 class="footer-col__title">Boutique</h2>
            <ul>
              <li><a href="{% if settings.featured_product != blank %}{{ settings.featured_product.url }}{% elsif all_products['eclat-dube'] != blank %}{{ all_products['eclat-dube'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">Éclat d’Ube</a></li>
              <li><a href="{% if settings.featured_product != blank %}{{ settings.featured_product.url }}{% elsif all_products['eclat-dube'] != blank %}{{ all_products['eclat-dube'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}?format=coffret-3">Coffrets</a></li>
              <li><a href="{{ routes.cart_url }}">Panier</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h2 class="footer-col__title">Découvrir</h2>
            <ul>
              <li><a href="{{ pages["decouvrir-ube"].url | default: "/pages/decouvrir-ube" }}">Découvrir l’ube</a></li>
              <li><a href="{{ pages["recettes"].url | default: "/pages/recettes" }}">Recettes</a></li>
              <li><a href="{{ pages["notre-histoire"].url | default: "/pages/notre-histoire" }}">Notre histoire</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h2 class="footer-col__title">Aide</h2>
            <ul>
              <li><a href="{{ pages["livraison"].url | default: "/pages/livraison" }}">Livraison et retours</a></li>
              <li><a href="{{ routes.root_url }}#faq">FAQ</a></li>
              <li><a href="{{ pages["contact"].url | default: "/pages/contact" }}">Contact</a></li>
            </ul>
          </div>
        </nav>
        {% form 'customer', id: 'newsletter', class: 'newsletter' %}
<input type="hidden" name="contact[tags]" value="newsletter">
          <label class="newsletter__title" for="nl-email">Une nouvelle recette dans votre boîte mail.</label>
          <p class="newsletter__hint">Une recette par mois et nos offres. Désinscription en un clic.</p>
          <div class="newsletter__row">
            <input id="nl-email" type="email" name="contact[email]" placeholder="Votre e-mail" required autocomplete="email">
            <button type="submit">S’inscrire</button>
          </div>
          <p class="newsletter__msg" aria-live="polite">{% if form.errors %}{{ form.errors | default_errors }}{% elsif form.posted_successfully? %}Merci ! Votre première recette arrive bientôt.{% endif %}</p>
        {% endform %}
      </div>
      <ul class="footer-trust">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>Livraison offerte dès&nbsp;45&nbsp;€</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>Paiement sécurisé</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7L4 8.5"/><path d="M4 4v4.5h4.5"/></svg>Retours sous 14 jours</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg><a href="mailto:contact@ubehalaya.fr">contact@ubehalaya.fr</a></li>
      </ul>
      <div class="footer-bottom">
        <p class="copyright">© <span data-year>2026</span> Ube Halaya</p>
        <ul class="footer-legal">
          <li><a href="{{ pages["mentions-legales"].url | default: "/pages/mentions-legales" }}">Mentions légales</a></li>
          <li><a href="{{ pages["cgv"].url | default: "/pages/cgv" }}">CGV</a></li>
          <li><a href="{{ pages["confidentialite"].url | default: "/pages/confidentialite" }}">Confidentialité</a></li>
        </ul>
      </div>
    </div>
  </footer>

  <!-- Cart drawer -->
  <div class="drawer-backdrop" data-close-cart></div>
  <aside class="drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="cart-title" inert>
    <div class="drawer__head">
      <h2 id="cart-title">Votre panier</h2>
      <button class="drawer__close" type="button" data-close-cart aria-label="Fermer le panier">×</button>
    </div>
    <div class="ship-progress">
      <span id="ship-msg"></span>
      <div class="ship-progress__bar"><span id="ship-bar"></span></div>
    </div>
    <ul class="drawer__items" id="cart-items"></ul>
    <div class="drawer__foot">
      <div class="drawer__row"><span>Sous-total</span><span id="cart-subtotal">0,00 €</span></div>
      <div class="drawer__row"><span>Livraison</span><span id="cart-shipping">—</span></div>
      <div class="drawer__row drawer__total"><span>Total</span><span id="cart-total">0,00 €</span></div>
      <form action="{{ routes.cart_url }}" method="post"><button class="btn btn--block" type="submit" name="checkout" id="checkout-btn">Passer commande</button></form>
      <a class="drawer__view" href="{{ routes.cart_url }}">Voir le panier</a>
      <p class="drawer__note">Paiement sécurisé · Livraison offerte dès 45 €</p>
    </div>
  </aside>

  <!-- First-visit offer: -10 % on the first order -->
  <dialog class="welcome" id="welcome" aria-labelledby="welcome-title">
    <img class="welcome__img" src="{{ 'ube-latte.webp' | asset_url }}" width="1000" height="750" alt="" loading="lazy">
    <div class="welcome__body">
      <button class="welcome__close" type="button" data-close-welcome aria-label="Fermer">×</button>
      <p class="script welcome__script">Bienvenue !</p>
      <h2 class="welcome__title" id="welcome-title">−10 % sur votre première commande</h2>
      {% form 'customer', id: 'welcome-newsletter', class: 'welcome__form' %}
<input type="hidden" name="contact[tags]" value="newsletter,bienvenue">{% if form.posted_successfully? %}<span data-welcome-success hidden></span>{% elsif form.errors %}<span data-welcome-error hidden></span>{% endif %}
        <p class="welcome__text">Laissez-nous votre e-mail et recevez votre code de bienvenue.</p>
        <label class="sr-only" for="welcome-email">Votre e-mail</label>
        <input class="input" id="welcome-email" type="email" name="contact[email]" placeholder="Votre e-mail" required autocomplete="email">
        <p class="welcome__error" aria-live="polite">{% if form.errors %}{{ form.errors | default_errors }}{% elsif form.posted_successfully? %}{% endif %}</p>
        <button class="btn btn--block" type="submit">Recevoir mon code</button>
        <p class="welcome__legal">Une recette par mois et nos offres. Désinscription en un clic. <a href="{{ pages["confidentialite"].url | default: "/pages/confidentialite" }}">Confidentialité</a></p>
      {% endform %}
      <div class="welcome__done" hidden>
        <p class="welcome__text">Votre code, à saisir lors de votre première commande :</p>
        <button class="welcome__code" type="button" data-copy-code="BIENVENUE10" aria-label="Copier le code BIENVENUE10">BIENVENUE10<span>Copier</span></button>
        <button class="btn btn--block" type="button" data-close-welcome>Découvrir la boutique</button>
      </div>
      <button class="welcome__skip" type="button" data-close-welcome>Non merci</button>
    </div>
  </dialog>

{% schema %}
{
  "name": "Pied de page",
  "settings": []
}
{% endschema %}
